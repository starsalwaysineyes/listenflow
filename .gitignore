# 构建产物与应用副本（可由 build.sh 重新生成）
*.app/
work/build/
work/ui-preview/
work/vision-export/

# 旧构建的归档备份（可回退用，不纳入版本控制）
work/archive/

# 测试与诊断二进制
work/*-tests
work/core-tests
work/clipboard-tests
work/vision-tests
work/winid
work/winid2
work/disp
work/organize-session
work/export-session
work/install_secret
work/normalize
work/probe
work/bounds
work/verify
work/inpaint

# 大体积录制样本（数 MB，非源码）
work/*.sample.txt
work/*.wav
work/*.png

# 图标中间产物（保留 Assets/AppIcon.icns 与 Assets/icon-1024.png）
work/icon-build/听流.iconset/
work/icon-build/icon-raw.png

# 系统与编辑器杂项
.DS_Store
*.swp
*~

# 识别实验的音频与输出（脚本与文本保留）
work/asr-lab/**/*.wav
work/asr-lab/**/*.aiff
work/asr-lab/*.pcm
work/asr-lab/out*.json
work/asr-lab/results*.json
work/asr-lab/__pycache__/
work/dbg/
work/asr-lab/*.log

# 真实会议转写，只留在本地
work/meeting-*.json
outputs/*-整理记录.md
work/release/
